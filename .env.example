# Mobility Pro Command - optional configuration.
#
# Copy to .env.local and uncomment what you need. Every variable is optional:
# anything left unset keeps that part simulated, and the UI reports it as a
# setup requirement.
# Never commit real values. Only this example file is tracked.

# --- Freight: storage ---------------------------------------------------------
# Needs a writable filesystem (see docs/FREIGHT_SETUP.md).
# FREIGHT_DATA_DIR=
# FREIGHT_DB_FILE=

# --- Freight: Microsoft Graph (shared by outgoing and incoming email) ---------
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# The mailbox RFQs are sent from and replies are collected from.
# GRAPH_MAILBOX=

# --- Freight: outgoing email ---------------------------------------------------
# simulated (default) | graph
MAIL_ADAPTER=simulated

# --- Freight: incoming email (reply collection) --------------------------------
# simulated (default) | graph
MAILBOX_ADAPTER=simulated
# Collect on a timer inside the server, in seconds (minimum 30). Unset = off.
# MAILBOX_POLL_SECONDS=
# Enables POST /api/freight/collect for an external scheduler, sent as
# "Authorization: Bearer <token>". Unset = the endpoint is switched off.
# MAILBOX_COLLECT_TOKEN=
# First run only: how far back to collect, in hours. Default 72.
# MAILBOX_INITIAL_LOOKBACK_HOURS=

# --- Freight: ERPNext ----------------------------------------------------------
# simulated (default) | live. The live adapter refuses to write until
# ERPNEXT_DOCTYPE names an agreed, verified DocType. It deliberately has no default.
ERPNEXT_ADAPTER=simulated
# ERPNEXT_BASE_URL=
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
# ERPNEXT_DOCTYPE=

# --- Freight: AI prose fallback (off by default; incurs cost) -----------------
# heuristic (default) | anthropic. Only enable with explicit authorisation.
AI_ADAPTER=heuristic
# ANTHROPIC_API_KEY=
# AI_MODEL=

# --- Operations demo -----------------------------------------------------------
# Reserved. No live n8n adapter is implemented; setting this connects nothing.
# N8N_BASE_URL=
