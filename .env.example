# Mobility Pro Command - optional configuration.
#
# Copy to .env.local and uncomment what you need. Every variable is optional:
# anything left unset keeps that part simulated, and the UI reports it as a
# setup requirement.
# Never commit real values. Only this example file is tracked.

# --- Freight: storage ---------------------------------------------------------
# Needs a writable filesystem (see docs/FREIGHT_SETUP.md).
# FREIGHT_DATA_DIR=
# FREIGHT_DB_FILE=

# --- Freight: Microsoft Graph (shared by outgoing and incoming email) ---------
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# The mailbox RFQs are sent from and replies are collected from.
# GRAPH_MAILBOX=

# --- Freight: sign-in ------------------------------------------------------------
# demo (default): the "Acting as" picker - a demonstration control, not security.
# entra: Sign in with Microsoft. Fails closed if the settings below are incomplete.
AUTH_MODE=demo
# A separate app registration from the mail one (web platform, delegated
# openid/profile/email, redirect URI <AUTH_BASE_URL>/api/freight/auth/callback).
# AUTH_ENTRA_TENANT_ID=
# AUTH_ENTRA_CLIENT_ID=
# AUTH_ENTRA_CLIENT_SECRET=
# AUTH_BASE_URL=https://freight.example.com
# Random, 32+ characters. Changing it signs everyone out.
# AUTH_SESSION_SECRET=
# First sign-in on an empty workspace only; remove once a manager exists.
# AUTH_BOOTSTRAP_ADMIN_EMAIL=

# --- Freight: outgoing email ---------------------------------------------------
# simulated (default) | graph
MAIL_ADAPTER=simulated

# --- Freight: incoming email (reply collection) --------------------------------
# simulated (default) | graph
MAILBOX_ADAPTER=simulated
# Collect on a timer inside the server, in seconds (minimum 30). Unset = off.
# MAILBOX_POLL_SECONDS=
# Enables POST /api/freight/collect for an external scheduler, sent as
# "Authorization: Bearer <token>". Unset = the endpoint is switched off.
# MAILBOX_COLLECT_TOKEN=
# First run only: how far back to collect, in hours. Default 72.
# MAILBOX_INITIAL_LOOKBACK_HOURS=
# on: colleagues on the People list can email "New RFQ" requests, which become
# DRAFT RFQs (never sent). Off by default until the customer confirms they want it.
# RFQ_EMAIL_INTAKE=on

# --- Freight: ERPNext ----------------------------------------------------------
# simulated (default) | live. The live adapter refuses to write until
# ERPNEXT_DOCTYPE names an agreed, verified DocType. It deliberately has no default.
ERPNEXT_ADAPTER=simulated
# ERPNEXT_BASE_URL=
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
# ERPNEXT_DOCTYPE=
# Company code here -> exact ERPNext Company name, as JSON.
# ERPNEXT_COMPANY_MAP={"MPD":"Mobility Pro Distribution S.A.E."}
# Only for scripts/erpnext-create-doctype.mjs, run once by an administrator.
# Do not leave an administrator's key on the server afterwards.
# ERPNEXT_ADMIN_API_KEY=
# ERPNEXT_ADMIN_API_SECRET=

# --- Freight: AI prose fallback (off by default; incurs cost) -----------------
# heuristic (default) | anthropic. Only enable with explicit authorisation.
AI_ADAPTER=heuristic
# ANTHROPIC_API_KEY=
# AI_MODEL=

# --- Operations demo -----------------------------------------------------------
# Reserved. No live n8n adapter is implemented; setting this connects nothing.
# N8N_BASE_URL=

# ---- Scheduled automation (n8n, cron) ----
# Bearer token for the /api/freight/automation/* endpoints. With no token set
# those endpoints return 404 rather than being left open.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Separate from MAILBOX_COLLECT_TOKEN so either can be rotated on its own.
# Nothing behind this token can send an email or approve one.
# See docs/FREIGHT_N8N.md.
FREIGHT_AUTOMATION_TOKEN=

# ---- Authentication ----
# The session cookie is marked Secure when the request arrives over HTTPS, or
# over a proxy that sets x-forwarded-proto. Set this to pin it on for a
# deployment you know is always behind TLS.
# FREIGHT_FORCE_SECURE_COOKIES=true

# ---- Microsoft Teams notifications (via n8n) ----
# An Incoming Webhook URL for the channel that should receive notifications.
# One URL is the whole configuration: no app registration, no OAuth.
# Teams > channel > Connectors > Incoming Webhook.
# With it set, `npm run n8n:provision` turns the placeholder notification nodes
# into real posts. Without it they stay placeholders.
# TEAMS_WEBHOOK_URL=
