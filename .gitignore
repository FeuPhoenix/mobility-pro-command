node_modules
.next
.demo-data
*.tsbuildinfo
next-env.d.ts
test-results
playwright-report

# Generated presentation and promotional artifacts
.presentation-build/
.codex-finalizer/
output/
brag-output/

.vercel
.env*
# The documented example holds no values and must stay tracked.
!.env.example

# Freight module: the local store and its generated attachments. Both are
# rebuilt by "Load demo data", so neither belongs in the repository.
data/
.freight-data-e2e/
.freight-pilot/

# Workflow exports regenerated with literal URLs for a specific n8n instance.
# The committed exports under public/n8n/ are the source of truth.
scripts/.n8n-workflows/

# Runtime logs from a locally started server
app.log
*.log

# Real provider quotations. The repository is public and these carry real rates
# and real contact addresses: never commit them, whatever they are named.
samples/
*.eml
*.msg
!tests/fixtures/**/*.eml

# Scratch scripts used while looking at real samples.
.lab-*

# Throwaway workspaces and backups made while testing. The application writes a
# database and attachments into whatever data directory it is given, so ignore
# the shapes those take rather than relying on remembering.
.qa*/
backups/
*.db
*.db-shm
*.db-wal
