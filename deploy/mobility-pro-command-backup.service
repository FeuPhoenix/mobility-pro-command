# Daily backup of the freight store. Pair with mobility-pro-command-backup.timer.
[Unit]
Description=Back up the Mobility Pro Command freight store

[Service]
Type=oneshot
User=freight
WorkingDirectory=/opt/mobility-pro-command
Environment=FREIGHT_DATA_DIR=/var/lib/mobility-pro-command
ExecStart=/usr/bin/node --no-warnings scripts/backup.mjs /var/backups/mobility-pro-command 14
