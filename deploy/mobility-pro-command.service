# systemd unit for a plain Linux server (no Docker).
#
#   sudo cp deploy/mobility-pro-command.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mobility-pro-command
#
# Assumes the app is checked out and built (npm ci && npm run build) in
# /opt/mobility-pro-command, owned by a "freight" user, with Node 22.5+.

[Unit]
Description=Mobility Pro Command (freight RFQ)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freight
WorkingDirectory=/opt/mobility-pro-command
EnvironmentFile=/opt/mobility-pro-command/.env.local
Environment=NODE_ENV=production
Environment=FREIGHT_DATA_DIR=/var/lib/mobility-pro-command
ExecStart=/usr/bin/npx next start -p 4310
Restart=on-failure
RestartSec=5
# The freight store is the only place it writes.
ReadWritePaths=/var/lib/mobility-pro-command
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
